# Razorpay (test mode only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: existing authorized test payment for capture flow
RAZORPAY_TEST_PAYMENT_ID=

# data.gov.in (MCA Company Master Data live lookup)
# Optional — falls back to public sample key (rate-limited)
DATA_GOV_IN_API_KEY=

# Apify (IndiaMART catalog provider — Phase 10)
# Free plan credits are enough for demos; without a token search_catalog returns []
APIFY_TOKEN=
APIFY_INDIAMART_ACTOR_ID=sourabhbgp~indiamart-scraper

# Optional GST taxpayer lookup proxy (portal is often blocked from servers).
# Use {gstin} placeholder or append /{gstin}. Without this, TrustGate still
# validates GSTIN format/checksum and audits [gst] format-only results.
# GST_VERIFY_URL=

# Optional locally. Required on Vercel production/preview (fail closed if missing).
# Unlocks the UI with a demo password; APIs also accept header x-trustgate-secret.
# TRUSTGATE_CONTROL_SECRET=

# Anthropic (buyer agent + explanations)
ANTHROPIC_API_KEY=
# Required for identity-linked personal keys (Claude Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
